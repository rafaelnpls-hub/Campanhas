<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <Button
            android:id="@+id/btnTema"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 Tema escuro"
            android:textAllCaps="false"
            android:layout_gravity="start"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚀"
            android:textSize="54sp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha Sua Equipe"
            android:textColor="#1D3557"
            android:textStyle="bold"
            android:textSize="30sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecione sua equipe para acessar a central de campanhas."
            android:textColor="#6B7280"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="34dp" />

        <Button
            android:id="@+id/btnContaChave"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="CONTA CHAVE\nAcessar campanhas"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#2D2D2D"
            android:backgroundTint="#FFD500"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnVarejo"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="VAREJO\nAcessar campanhas"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0056B3" />

        <TextView
            android:id="@+id/rodape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Central de Campanhas"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:layout_marginTop="36dp" />

    </LinearLayout>
</ScrollView>
